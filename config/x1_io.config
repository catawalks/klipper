# Klipper build config: Sindoh 3DWOX 1X / 2X (88PA6270) UPC IO core
# Use: cp x1_io.config ~/klipper/.config && make olddefconfig && make
CONFIG_MACH_UPC=y
CONFIG_UPC_CORE_IO=y
# Inputs come from the SoC GPIO block (pins gpio0..gpio255)
CONFIG_UPC_GPIO_BLOCK=y
# Timer: XENA Timer1, 398.04 MHz (measured on a 1X with the probe firmware)
CONFIG_CLOCK_FREQ=398000000
CONFIG_UPC_TIMER_ADDR=0x08001144
CONFIG_UPC_THUMB=y
CONFIG_UPC_ADC_SETTLE_US=10000
# Trim optional features to fit the 16 KiB ITCM
CONFIG_WANT_ADC=y
CONFIG_WANT_HARD_PWM=y
# CONFIG_WANT_TRIGGER_ANALOG is not set
CONFIG_WANT_BUTTONS=y
# CONFIG_WANT_TMCUART is not set
# CONFIG_WANT_NEOPIXEL is not set
# CONFIG_WANT_PULSE_COUNTER is not set
# CONFIG_WANT_ST7920 is not set
# CONFIG_WANT_HD44780 is not set
# CONFIG_WANT_HX71X is not set
# CONFIG_WANT_CS1237 is not set
