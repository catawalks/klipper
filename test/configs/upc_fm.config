# Base config file for the Marvell 88PA6170 UPC FM core (Sindoh DP200)
CONFIG_MACH_UPC=y
CONFIG_UPC_CORE_FM=y
CONFIG_UPC_STEP_BATCH=y
CONFIG_WANT_BUTTONS=y
CONFIG_WANT_TMCUART=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_CS1237=n
